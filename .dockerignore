# ---------- Python artifacts ----------
__pycache__/        # compiled Python bytecode cache directories
*.pyc               # compiled Python files
*.pyo               # optimized Python files
*.pyd               # compiled extension modules

# ---------- Virtual environments ----------
venv/               # local virtual environment folder
.env                # environment variables file (contains secrets, must not be copied)

# ---------- Testing & coverage ----------
tests/              # test files (not needed in container image)
.coverage           # coverage data file
htmlcov/            # coverage HTML reports
*.log               # log files generated during dev/test

# ---------- Local dev artifacts ----------
.DS_Store           # macOS Finder metadata
*.swp               # Vim swap files
*.swo               # Vim temporary files

# ---------- Git metadata ----------
.git                # Git repo data (not needed in container)
.gitignore          # ignore rules file itself

# ---------- Build outputs ----------
dist/               # distribution packages
build/              # build artifacts
*.egg-info/         # Python package metadata

# ---------- Docker artifacts ----------
docker-compose.yml  # local Docker Compose config (not needed inside container)
