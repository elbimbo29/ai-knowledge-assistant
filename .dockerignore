# Ignore Python cache and bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environments
venv/
.env

# Ignore test files and coverage reports
tests/
.coverage
htmlcov/
*.log

# Ignore local development artifacts
.DS_Store
*.swp
*.swo

# Ignore Git files
.git
.gitignore

# Ignore build outputs
dist/
build/
*.egg-info/

# Ignore Docker files not needed inside container
docker-compose.yml
